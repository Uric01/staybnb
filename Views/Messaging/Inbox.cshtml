@model MessageListViewModel

@{
    ViewData["Title"] = "Messages - Inbox";
}

<div class="container-fluid py-5">
    <div class="row h-100">
        <!-- Message List -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-chat-dots"></i> Messages
                        @if (Model.UnreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill">@Model.UnreadCount</span>
                        }
                    </h5>
                </div>
                <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                    @if (Model.Conversations.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var conversation in Model.Conversations.OrderByDescending(c => c.LastMessageTime))
                            {
                                <a href="@Url.Action("Conversation", new { otherUserId = conversation.OtherUserId })"
                                   class="list-group-item list-group-item-action @(conversation.IsUnread ? "active" : "")">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div style="flex: 1;">
                                            <h6 class="mb-1">@conversation.OtherUserName</h6>
                                            <p class="mb-1 text-truncate" style="font-size: 0.85rem;">
                                                @if (conversation.LastMessage.Length > 50)
                                                {
                                                    @(conversation.LastMessage.Substring(0, 50) + "...")
                                                }
                                                else
                                                {
                                                    @conversation.LastMessage
                                                }
                                            </p>
                                            <small class="text-muted">@conversation.LastMessageTime.ToString("MMM dd, HH:mm")</small>
                                        </div>
                                        @if (conversation.UnreadCount > 0)
                                        {
                                            <span class="badge bg-danger rounded-pill">@conversation.UnreadCount</span>
                                        }
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <p>No conversations yet.</p>
                            <small>Start a conversation by sending a message to another user.</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Select Conversation Notice -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-chat-dots" style="font-size: 3rem; color: #ccc;"></i>
                    <h5 class="mt-3 text-muted">Select a conversation</h5>
                    <p class="text-muted">Click on a message to view the conversation or start a new one.</p>
                </div>
            </div>
        </div>
    </div>
</div>
