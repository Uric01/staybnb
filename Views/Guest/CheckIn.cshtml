@model GuestCheckInViewModel

@{
    ViewData["Title"] = "Check-in: " + Model.PropertyTitle;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Check-in: @Model.PropertyTitle</h5>
                </div>

                <div class="card-body">
                    <!-- Progress -->
                    <div class="progress mb-4">
                        <div class="progress-bar" role="progressbar" style="width: @((int)Model.Status * 33)%"></div>
                    </div>

                    @switch(Model.Status)
                    {
                        case CheckInStatus.NotStarted:
                            <p class="text-muted">Check-in hasn't started yet</p>
                            break;

                        case CheckInStatus.InProgress:
                            <div class="mb-4">
                                <h5>Check-in Rules</h5>
                                @if (!string.IsNullOrEmpty(Model.CheckInRules))
                                {
                                    <div class="alert alert-info">
                                        @foreach (var line in Model.CheckInRules.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <p class="mb-1">• @line</p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">No specific rules defined</p>
                                }
                            </div>

                            <div class="mb-4">
                                <h5>Required Documents</h5>
                                @if (!string.IsNullOrEmpty(Model.RequiredDocuments))
                                {
                                    <div class="alert alert-warning">
                                        <strong>Please upload the following:</strong>
                                        @foreach (var line in Model.RequiredDocuments.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <p class="mb-1">• @line</p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">No documents required</p>
                                }
                            </div>

                            <!-- Document Upload -->
                            <div class="mb-4">
                                <h5>Upload Documents</h5>
                                <form method="post" asp-action="UploadDocument" enctype="multipart/form-data">
                                    <input type="hidden" name="checkInId" value="@Model.BookingId" />
                                    <div class="input-group">
                                        <input type="file" class="form-control" id="documentFile" name="documentFile" required accept="image/*,.pdf">
                                        <button class="btn btn-primary" type="submit">Upload</button>
                                    </div>
                                </form>
                            </div>

                            <!-- Uploaded Documents -->
                            @if (Model.UploadedDocuments.Any())
                            {
                                <div class="mb-4">
                                    <h5>Uploaded Documents</h5>
                                    @foreach (var doc in Model.UploadedDocuments)
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body d-flex justify-content-between align-items-center">
                                                <div>
                                                    <i class="bi bi-file-pdf"></i>
                                                    <small class="ms-2">@doc.UploadedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                                </div>
                                                <span>
                                                    @switch(doc.Status)
                                                    {
                                                        case DocumentStatus.Pending:
                                                            <span class="badge bg-warning">Pending Review</span>
                                                            break;
                                                        case DocumentStatus.Verified:
                                                            <span class="badge bg-success">Verified</span>
                                                            break;
                                                        case DocumentStatus.Rejected:
                                                            <span class="badge bg-danger">Rejected</span>
                                                            break;
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Complete Check-in -->
                            <div class="d-grid gap-2">
                                <form method="post" asp-action="CompleteCheckIn">
                                    <input type="hidden" name="bookingId" value="@Model.BookingId" />
                                    <button type="submit" class="btn btn-success btn-lg">Complete Check-in</button>
                                </form>
                            </div>
                            break;

                        case CheckInStatus.Completed:
                            <div class="alert alert-success text-center">
                                <h5>Check-in Completed!</h5>
                                <p>Enjoy your stay at @Model.PropertyTitle</p>
                            </div>
                            break;
                    }
                </div>
            </div>

            <div class="mt-3">
                <a href="@Url.Action("MyBookings")" class="btn btn-secondary">Back to Bookings</a>
            </div>
        </div>
    </div>
</div>
