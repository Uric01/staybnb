@model HostApplicationDetailViewModel

@{
    ViewData["Title"] = "Review Application";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Application Details</h5>
                </div>

                <div class="card-body">
                    <!-- Applicant Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Applicant Information</h6>
                            <p>
                                <strong>@Model.ApplicantName</strong><br/>
                                <small class="text-muted">@Model.ApplicantEmail</small>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Application Status</h6>
                            <p>
                                @switch(Model.Status)
                                {
                                    case ApplicationStatus.Pending:
                                        <span class="badge bg-warning">Pending Review</span>
                                        break;
                                    case ApplicationStatus.Approved:
                                        <span class="badge bg-success">Approved</span>
                                        break;
                                    case ApplicationStatus.Rejected:
                                        <span class="badge bg-danger">Rejected</span>
                                        break;
                                }
                                <br/>
                                <small class="text-muted">Submitted: @Model.AppliedAt.ToString("MMM dd, yyyy")</small>
                            </p>
                        </div>
                    </div>

                    <hr/>

                    <!-- Property Details -->
                    <h6 class="text-muted mb-3">Property Details</h6>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p>
                                <strong>Title:</strong> @Model.PropertyTitle<br/>
                                <strong>Type:</strong> @Model.PropertyType<br/>
                                <strong>Max Guests:</strong> @Model.MaxGuests
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p>
                                <strong>Address:</strong> @Model.Address<br/>
                                <strong>City:</strong> @Model.City<br/>
                                <strong>Price/Night:</strong> $@Model.PricePerNight
                            </p>
                        </div>
                    </div>

                    <div class="mb-4">
                        <strong>Description:</strong>
                        <p class="mt-2">@Model.PropertyDescription</p>
                    </div>

                    <!-- Property Images -->
                    @if (Model.PropertyImages.Any())
                    {
                        <div class="mb-4">
                            <h6 class="text-muted mb-3">Property Images</h6>
                            <div class="row g-3">
                                @foreach (var image in Model.PropertyImages.Take(6))
                                {
                                    <div class="col-md-4">
                                        <img src="@image" class="img-fluid rounded" alt="Property image" style="height: 200px; object-fit: cover; width: 100%;">
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <hr/>

                    <!-- Decision Actions -->
                    @if (Model.Status == ApplicationStatus.Pending)
                    {
                        <div class="alert alert-info mb-4">
                            <strong>Action Required:</strong> Please review the application details above and approve or reject.
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <form method="post" asp-action="ApproveApplication" class="d-grid gap-2">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="bi bi-check-circle"></i> Approve Application
                                    </button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <button type="button" class="btn btn-danger btn-lg w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                    <i class="bi bi-x-circle"></i> Reject Application
                                </button>
                            </div>
                        </div>

                        <!-- Reject Modal -->
                        <div class="modal fade" id="rejectModal" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form method="post" asp-action="RejectApplication">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <div class="modal-header">
                                            <h5 class="modal-title">Reject Application</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label for="reason" class="form-label">Rejection Reason *</label>
                                                <textarea class="form-control" id="reason" name="reason" rows="4" required placeholder="Provide a clear reason for rejection..."></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger">Reject</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <strong>This application has already been reviewed.</strong>
                            Status: @Model.Status
                        </div>
                        <a href="@Url.Action("Applications")" class="btn btn-secondary">Back to Applications</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
