@model ManagePropertyViewModel

@{
    ViewData["Title"] = "Edit Property";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Edit Property: @Model.Title</h2>

            <form method="post" asp-antiforgery="true">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Basic Information</h5>

                        <div class="mb-3">
                            <label for="Title" class="form-label">Property Title</label>
                            <input type="text" class="form-control" id="Title" name="Title" 
                                   value="@Model.Title" required>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control" id="Description" name="Description" 
                                      rows="4" required>@Model.Description</textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="Address" class="form-label">Address</label>
                                <input type="text" class="form-control" id="Address" name="Address" 
                                       value="@Model.Address" required>
                            </div>
                            <div class="col-md-6">
                                <label for="City" class="form-label">City</label>
                                <input type="text" class="form-control" id="City" name="City" 
                                       value="@Model.City" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="PropertyType" class="form-label">Type</label>
                                <input type="text" class="form-control" id="PropertyType" name="PropertyType" 
                                       value="@Model.PropertyType" required>
                            </div>
                            <div class="col-md-6">
                                <label for="MaxGuests" class="form-label">Max Guests</label>
                                <input type="number" class="form-control" id="MaxGuests" name="MaxGuests" 
                                       value="@Model.MaxGuests" min="1" required>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Pricing</h5>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="PricePerNight" class="form-label">Price per Night ($)</label>
                                <input type="number" class="form-control" id="PricePerNight" name="PricePerNight" 
                                       value="@Model.PricePerNight" step="0.01" required>
                            </div>
                            <div class="col-md-4">
                                <label for="CleaningFee" class="form-label">Cleaning Fee ($)</label>
                                <input type="number" class="form-control" id="CleaningFee" name="CleaningFee" 
                                       value="@Model.CleaningFee" step="0.01">
                            </div>
                            <div class="col-md-4">
                                <label for="ServiceFee" class="form-label">Service Fee ($)</label>
                                <input type="number" class="form-control" id="ServiceFee" name="ServiceFee" 
                                       value="@Model.ServiceFee" step="0.01">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Current Images</h5>

                        @if (Model.PropertyImages.Any())
                        {
                            <div class="row g-3">
                                @foreach (var image in Model.PropertyImages)
                                {
                                    <div class="col-md-4">
                                        <div class="card">
                                            <img src="@image.ImageUrl" class="card-img-top" alt="Property image" style="height: 150px; object-fit: cover;">
                                            <div class="card-body p-2">
                                                <form method="post" action="@Url.Action("DeleteImage")" style="display: inline;">
                                                    <input type="hidden" name="imageId" value="@image.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger w-100">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No images uploaded yet.</p>
                        }
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">Save Changes</button>
                    <a href="@Url.Action("Properties")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
