@model List<PropertyListItemViewModel>

@{
    ViewData["Title"] = "My Properties";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Properties</h1>
        <a href="@Url.Action("CreateProperty")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Property
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var property in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(property.ThumbnailUrl))
                        {
                            <img src="@property.ThumbnailUrl" class="card-img-top" alt="@property.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-image" style="font-size: 3rem; color: #ccc;"></i>
                            </div>
                        }
                        
                        <div class="card-body">
                            <h5 class="card-title">@property.Title</h5>
                            <p class="card-text text-muted">@property.City</p>
                            
                            <div class="mb-3">
                                <p class="mb-1"><strong>$@property.PricePerNight</strong> per night</p>
                                <small class="text-muted">@property.BookingCount bookings</small>
                            </div>

                            <div class="mb-3">
                                @if (property.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                @if (property.PendingBookingsCount > 0)
                                {
                                    <span class="badge bg-warning">@property.PendingBookingsCount Pending</span>
                                }
                            </div>
                        </div>

                        <div class="card-footer bg-white">
                            <div class="d-grid gap-2">
                                <a href="@Url.Action("EditProperty", new { id = property.Id })" class="btn btn-sm btn-primary">
                                    Edit
                                </a>
                                <form method="post" action="@Url.Action("ToggleActive", new { id = property.Id })" style="display: inline;">
                                    @if (property.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-warning w-100">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-success w-100">Activate</button>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h5>No properties yet</h5>
            <p class="mb-3">Start listing your properties to begin earning</p>
            <a href="@Url.Action("CreateProperty")" class="btn btn-primary btn-lg">Create Your First Property</a>
        </div>
    }
</div>
