@model List<BookingApprovalViewModel>

@{
    ViewData["Title"] = "Booking Requests";
}

<div class="container py-5">
    <h1 class="mb-4">Booking Requests</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Guest</th>
                        <th>Property</th>
                        <th>Check-In</th>
                        <th>Check-Out</th>
                        <th>Guests</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>
                                <strong>@booking.GuestName</strong><br/>
                                <small class="text-muted">@booking.GuestEmail</small>
                            </td>
                            <td>@booking.PropertyTitle</td>
                            <td>@booking.CheckInDate.ToString("MMM dd, yyyy")</td>
                            <td>@booking.CheckOutDate.ToString("MMM dd, yyyy")</td>
                            <td>@booking.NumberOfGuests</td>
                            <td>$@booking.TotalPrice.ToString("F2")</td>
                            <td>
                                @switch(booking.Status)
                                {
                                    case BookingStatus.Pending:
                                        <span class="badge bg-warning">Pending</span>
                                        break;
                                    case BookingStatus.Approved:
                                        <span class="badge bg-success">Approved</span>
                                        break;
                                    case BookingStatus.Rejected:
                                        <span class="badge bg-danger">Rejected</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@booking.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (booking.Status == BookingStatus.Pending)
                                {
                                    <form method="post" action="@Url.Action("ApproveBooking", new { id = booking.Id })" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                    <form method="post" action="@Url.Action("RejectBooking", new { id = booking.Id })" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h5>No booking requests</h5>
            <p>You'll see new booking requests here</p>
        </div>
    }
</div>
